    "@types/jest-axe": "^3.5.9",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "eslint-config-next": "^15.1.3",
    "jest-axe": "^9.0.0",
    "jsdom": "^25.0.1",
